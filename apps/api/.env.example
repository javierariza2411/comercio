# --- Servidor ---
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# --- Base de datos (Docker: infra/docker-compose.yml expone Postgres en 5433) ---
DATABASE_URL=postgresql://smartcommerce:smartcommerce@localhost:5433/smartcommerce?schema=public

# --- Redis (colas, cache, pub/sub) ---
REDIS_URL=redis://localhost:6379

# --- Autenticación ---
# Genera uno con: openssl rand -hex 32  (obligatorio en producción, mínimo 32 caracteres)
JWT_SECRET=dev-only-change-me-dev-only-change-me-0000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# --- Almacenamiento S3 compatible (RustFS local / Cloudflare R2 en producción) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=smartcommerce
S3_ACCESS_KEY=smartcommerce
S3_SECRET_KEY=smartcommerce123
S3_FORCE_PATH_STYLE=true

# --- IA (Fase 1) ---
AI_PROVIDER=disabled
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
