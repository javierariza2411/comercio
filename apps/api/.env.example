# --- Servidor ---
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# --- Base de datos (Docker: infra/docker-compose.yml expone Postgres en 5433) ---
DATABASE_URL=postgresql://smartcommerce:smartcommerce@localhost:5433/smartcommerce?schema=public

# --- Redis (colas, cache, pub/sub) ---
REDIS_URL=redis://localhost:6379

# --- Autenticación ---
# Genera uno con: openssl rand -hex 32  (obligatorio en producción, mínimo 32 caracteres)
JWT_SECRET=dev-only-change-me-dev-only-change-me-0000
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# --- Almacenamiento S3 compatible (RustFS local / Neon Object Storage en producción) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=smartcommerce
# URL pública base del bucket, sin barra final. En Neon normalmente es ENDPOINT/BUCKET.
# S3_PUBLIC_URL=https://endpoint-del-storage/bucket
S3_ACCESS_KEY=smartcommerce
S3_SECRET_KEY=smartcommerce123
S3_FORCE_PATH_STYLE=true

# Neon también entrega AWS_ENDPOINT_URL_S3, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY y AWS_REGION.
# La API acepta esos nombres directamente; S3_BUCKET sigue siendo obligatorio.

# --- IA ---
# disabled = proveedor mock determinista (sin costo, para desarrollo/CI). gemini = Google Gemini.
AI_PROVIDER=disabled
GEMINI_API_KEY=
# Nombres de modelo configurables; verifica los disponibles en tu cuenta antes de producción.
GEMINI_MODEL_SMALL=gemini-2.5-flash
GEMINI_MODEL_LARGE=gemini-2.5-pro
GEMINI_MODEL_EMBEDDING=text-embedding-004
EMBEDDING_DIMENSIONS=768
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Widget ---
# Carpeta con embed.js/widget.html compilados (por defecto packages/widget/dist del monorepo)
# WIDGET_ASSETS_DIR=/ruta/a/packages/widget/dist
