{
  "name": "@smartcommerce/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main",
    "seed": "ts-node src/scripts/seed.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
